<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: هیچ داده‌ای به بکاپ ابری/انتقال دستگاه منتقل نشود.
     SharedPreferences این اپ شامل سفارش‌ها (آدرس/موبایل)، هش رمز و
     شماره کارت است و نباید خارج از دستگاه کپی شود. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
